# Copy this file to .env and fill in real values:
#   cp .env.example .env
# .env is ignored by git. Never commit it, never put these values in firmware.

# --- Groq -----------------------------------------------------------------
# API key from https://console.groq.com/keys
GROQ_API_KEY=
# Chosen in Phase 4 after testing the models available to the account.
GROQ_MODEL=qwen/qwen3.8-27b

# --- Gateway authentication -------------------------------------------------
# Comma-separated device_id:token pairs. One per ESP32 gateway.
# Generate a token:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKENS=tcall-01:CHANGE_ME_generate_a_real_token

# --- Monitoring ---------------------------------------------------------------
# Bearer token for GET /v1/admin/stats. Empty = admin API disabled.
ADMIN_TOKEN=

# --- Optional (defaults shown) ------------------------------------------------
# DATABASE_URL=sqlite:///./nodus.db
# SMS_MAX_SEGMENTS=3
# SMS_TARGET_CHARS=300
# DEFAULT_COUNTRY_CODE=257
# CONTEXT_TURNS=6
# CONTEXT_MAX_AGE_HOURS=24
# RATE_LIMIT_PER_HOUR=15
# RATE_LIMIT_PER_DAY=60
# GROQ_TIMEOUT_S=20
# OUTBOX_LEASE_S=180
# GATEWAY_OFFLINE_AFTER_S=300
# LOG_LEVEL=INFO
